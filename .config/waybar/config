{
  "layer": "top",
  "position": "top",
  "margin-top": 4,
  "margin-left": 4,
  "margin-right": 4,
  "margin-bottom": 0,
  "spacing": 0,

  "modules-left": [
    "custom/os",
    "group/leftcapsule"
  ],
  
  "modules-center": [
    "clock"
  ],
  
  "modules-right": [
    "tray",
    "cpu",
    "memory",
    "hyprland/language",
    "bluetooth",
    "network",
    "pulseaudio",
    "backlight",
    "battery",
    "custom/power"
  ],

  "group/leftcapsule": {
    "orientation": "horizontal",
    "modules": [
      "hyprland/workspaces",
      "mpris"
    ]
  },

  "custom/os": {
    "format": "",
    "tooltip": false,
    "on-click": "pkill rofi || rofi -show drun"
  },

  "hyprland/workspaces": {
    "on-click": "hyprctl dispatch workspace {id}",
    "on-scroll-up": "hyprctl dispatch workspace e+1",
    "on-scroll-down": "hyprctl dispatch workspace e-1",
    "disable-scroll": false,
    "all-outputs": true,
    "format": "{icon}",
    "format-icons": {
      "active": "󰮯",
      "default": "󰊠",
      "urgent": "󰀨"
    },
    "persistent-workspaces": {
      "1": [], "2": [], "3": [], "4": []
    }
  },

  "cpu": {
    "interval": 2,
    "format": " {usage}%",
    "tooltip": true,
    "tooltip-format": "  Protsessor (CPU)\n───────────────────────\n• Yuklama:       {usage}%\n• Chastota:      {avg_frequency} GHz",
    "on-click": "gnome-system-monitor || kitty -e btop"
  },

  "memory": {
    "interval": 2,
    "format": " {percentage}%",
    "tooltip-format": "  Tezkor Xotira (RAM)\n───────────────────────\n• Band xotira:   {used:0.1f} GB\n• Jami hajm:     {total:0.1f} GB\n• Bandlik:       {percentage}%",
    "on-click": "gnome-system-monitor || kitty -e btop"
  },

  "mpris": {
    "format": " {status_icon} {dynamic}",
    "format-paused": " {status_icon} <i>{dynamic}</i>",
    "tooltip-format": "  Musiqa Pleyeri\n───────────────────────\n• Ijrochi:  {artist}\n• Nomi:     {title}\n• Albom:    {album}",
    "status-icons": {
      "playing": "▶",
      "paused": "⏸"
    },
    "dynamic-len": 30,
    "dynamic-order": ["artist", "title"],
    "on-click": "playerctl play-pause",
    "on-click-right": "playerctl next"
  },

  "clock": {
    "format": " {:%H:%M  •  %d %b}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "on-click": "gnome-calendar",
    "calendar": {
      "mode": "month",
      "mode-mon-col": 3,
      "on-scroll": 1,
      "format": {
        "months": "<span color='#b1c5ff'><b>{}</b></span>",
        "days": "<span color='#e2e2e9'><b>{}</b></span>",
        "weeks": "<span color='#c0c6dd'><b>W{}</b></span>",
        "weekdays": "<span color='#304578'><b>{}</b></span>",
        "today": "<span color='#ffb4ab'><b><u>{}</u></b></span>"
      }
    }
  },

  "tray": {
    "icon-size": 16,
    "spacing": 10
  },

  "hyprland/language": {
    "format": " {}",
    "format-en": "EN",
    "format-ru": "RU",
    "format-uz": "UZ",
    "tooltip-format": "  Klaviatura Tili\n───────────────────────\n• Joriy tartib:  {}"
  },

  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "tooltip-format": "  Bluetooth\n───────────────────────\n• Qurilma:  {controller_alias}\n• Manzil:   {controller_address}",
    "tooltip-format-connected": "  Bluetooth ({num_connections} ta)\n───────────────────────\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "• {device_alias}\t({device_address})",
    "tooltip-format-enumerate-connected-battery": "• {device_alias}\t󰥉 {device_battery_percentage}%",
    "on-click": "blueman-manager"
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}% ⬇ {bandwidthDownBytes}",
    "format-ethernet": "󰈀 {ipaddr} ⬇ {bandwidthDownBytes}",
    "format-disconnected": "󰤭 ",
    "interval": 2,
    "tooltip-format-wifi": "󰤨  {essid}\n───────────────────────\n• Signal:       {signalStrength}%\n• IP manzil:    {ipaddr}\n• Yuklash (⬇):  {bandwidthDownBytes}\n• Jo'natish (⬆): {bandwidthUpBytes}",
    "tooltip-format-ethernet": "󰈀  {ifname}\n───────────────────────\n• IP manzil:    {ipaddr}\n• Yuklash (⬇):  {bandwidthDownBytes}\n• Jo'natish (⬆): {bandwidthUpBytes}",
    "tooltip-format-disconnected": "󰤭  Tarmoqqa ulanmagan",
    "on-click": "networkmanager_dmenu"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 Muted",
    "tooltip-format": "{icon}  Ovoz Boshqaruvi\n───────────────────────\n• Balandlik:    {volume}%\n• Chiqish:      {desc}",
    "tooltip-format-muted": "󰝟  Ovoz O'chirilgan\n───────────────────────\n• Chiqish:      {desc}",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "on-click": "pavucontrol",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "backlight": {
    "device": "intel_backlight",
    "format": "{icon} {percent}%",
    "tooltip-format": "{icon}  Ekran Yorug'ligi\n───────────────────────\n• Daraja:       {percent}%",
    "format-icons": ["󰃞", "󰃟", "󰃠"],
    "on-scroll-up": "brightnessctl set +5%",
    "on-scroll-down": "brightnessctl set 5%-"
  },

  "battery": {
    "bat": "BAT1",
    "adapter": "ACAD",
    "interval": 2,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": "󰚥 {capacity}%",
    "format-icons": ["󰂎", "󰁺", "󰁼", "󰁾", "󰂀", "󰁹"],
    "tooltip-format": "󰁹  Batareya\n───────────────────────\n• Zaryad:       {capacity}%\n• Qolgan vaqt:  {time}",
    "tooltip-format-charging": "󰂄  Quvvatlanmoqda\n───────────────────────\n• Zaryad:       {capacity}%\n• To'lish vaqti: {time}",
    "tooltip-format-plugged": "󰚥  Tarmoqqa Ulangan\n───────────────────────\n• Zaryad:       {capacity}%"
  },

  "custom/power": {
    "format": "",
    "tooltip": false,
    "on-click": "pkill -x wlogout || wlogout"
  }
}
